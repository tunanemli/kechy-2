# Copy to .env.local for local development, or set these in your hosting provider.

# Public URL of the live site, without a trailing slash (e.g. https://example.com).
# Used for canonical URLs, hreflang links, the sitemap and Open Graph images.
# If unset: Vercel's production URL is used when deployed there, otherwise http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com
